# Copy this file to .env.local for local development. Never commit real values.
# Server-only values belong in Vercel (or another deployment provider) environment settings.

# Optional Vercel Edge Config connection. Treat a populated value as sensitive.
EDGE_CONFIG=

# Server-side Gemini API configuration
GEMINI_API_KEY=
GEMINI_ALLOWED_ORIGINS=http://localhost:3000
TOOLS_ALLOWED_ORIGINS=http://localhost:3000

# Browser-visible Unsplash access key. This is not a private secret; restrict it by domain in Unsplash.
REACT_APP_UNSPLASH_ACCESS_KEY=

# Optional local React build settings
GENERATE_SOURCEMAP=false
FAST_REFRESH=true
SKIP_PREFLIGHT_CHECK=true
